# ========================================================
# PORTAL ARVIC — VARIABLES DE ENTORNO DE EJEMPLO
# Copia este archivo como .env y rellena con tus valores reales
# ========================================================

# Base de Datos (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0

# Puerto del Servidor Backend
PORT=3000

# Entorno ('development' | 'production')
NODE_ENV=production

# Seguridad y Autenticación JWT (Cadena secreta aleatoria segura)
JWT_SECRET=tu_clave_secreta_jwt_minimo_64_caracteres_hexadecimal

# Longitud mínima de contraseña
MIN_PASSWORD_LENGTH=10

# Rate Limiting (Seguridad anti-fuerza bruta)
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=25

# Servicio de Correo Transaccional (Nodemailer / SMTP)
EMAIL_USER=soporte@tuempresa.com
EMAIL_PASS=tu_app_password_o_contraseña_smtp
EMAIL_FROM="Portal ARVIC" <soporte@tuempresa.com>

# URLs y Orígenes Permitidos (CORS)
APP_URL=https://app.grupoitarvic.com
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://app.grupoitarvic.com
ALLOW_VERCEL_PREVIEWS=false

# Límite de carga de payloads (Adjuntos en Base64, PDFs, CSF)
REQUEST_BODY_LIMIT=10mb

# Inteligencia Artificial / Asistente Virtual ARVIC (Google Gemini)
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
